# Set default behavior to automatically normalize line endings
* text=auto eol=lf

# Force shell scripts to use LF line endings
*.sh text eol=lf

# Force batch files to use CRLF line endings
*.bat text eol=crlf

# Denote all files that are truly binary and should not be modified
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.tar binary
*.gz binary

