# ==============================================================================
# FLUX Backend Configuration
# ==============================================================================
# Copy this file to .env and fill in your actual values
# Do NOT commit the .env file to version control


# ==============================================================================
# AWS CREDENTIALS (Required)
# ==============================================================================
# OPTION 1: Use AWS Profile (Recommended - More Secure)
# Run: aws configure --profile default
# Then set:
AWS_PROFILE=default

# OPTION 2: Direct Credentials (Not Recommended)
# Only use if you can't use AWS profiles
# AWS_ACCESS_KEY_ID=your_access_key_here
# AWS_SECRET_ACCESS_KEY=your_secret_key_here

# AWS Region with Bedrock access
AWS_REGION=us-east-1

# AWS Bedrock Model ID (use inference profile for Claude 3.5 Sonnet v2)
AWS_BEDROCK_MODEL_ID=us.anthropic.claude-3-5-sonnet-20241022-v2:0


# ==============================================================================
# RESEARCH PARAMETERS
# ==============================================================================
# Maximum number of research iterations (orbits)
# Default: 1 (single pass through all agents)
# Increase for more thorough research, but watch costs
MAX_ITERATIONS=1

# Minimum quality score (0-10) to consider research complete
# Research stops when quality >= this threshold
QUALITY_THRESHOLD=8.0

# Minimum quality improvement between iterations
# Research stops if improvement < this threshold
IMPROVEMENT_THRESHOLD=0.5


# ==============================================================================
# SEARCH API (Optional - for Source Agent)
# ==============================================================================
# Tavily API key for web search
# Get your key at: https://tavily.com/
# TAVILY_API_KEY=your_tavily_key_here


# ==============================================================================
# LOGGING
# ==============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO


# ==============================================================================
# CORS (Cross-Origin Resource Sharing)
# ==============================================================================
# Comma-separated list of allowed origins
# Default: http://localhost:3000 (frontend URL)
CORS_ORIGINS=http://localhost:3000


# ==============================================================================
# NOTES
# ==============================================================================
# 
# MAX_ITERATIONS explained:
# - 1 = Single pass (fast, lower quality, lower cost)
# - 2-3 = Multiple refinements (balanced, recommended for important research)
# - 4+ = Deep research (slow, high quality, high cost)
# 
# QUALITY_THRESHOLD explained:
# - Lower (6-7) = Accept good enough research
# - Medium (8-9) = High quality research (recommended)
# - High (9-10) = Very strict, may require many iterations
# 
# Cost considerations:
# - Each iteration calls Claude 3.5 Sonnet ~6 times (one per agent)
# - More iterations = more LLM calls = higher AWS costs
# - Balance quality needs with budget constraints
#
